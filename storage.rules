rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    /* ============================================================
       AUTH HELPERS
       ============================================================ */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }

    function isTeacher() {
      return isSignedIn()
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.role == "teacher";
    }

    /* ============================================================
       COURSE OWNERSHIP
       ============================================================ */

    function isCourseOwner(courseId) {
      return isSignedIn()
        && firestore.exists(
          /databases/(default)/documents/courses/$(courseId)
        )
        && firestore.get(
          /databases/(default)/documents/courses/$(courseId)
        ).data.instructorId == request.auth.uid;
    }

    /* ============================================================
       COURSE ENROLLMENT
       ============================================================ */

    function isEnrolled(courseId) {
      return isSignedIn()
        && (
          firestore.exists(
            /databases/(default)/documents/enrollments/$(request.auth.uid + "_" + courseId)
          )
          ||
          (
            firestore.exists(
              /databases/(default)/documents/users/$(request.auth.uid)/enrollments/$(courseId)
            )
            &&
            firestore.get(
              /databases/(default)/documents/users/$(request.auth.uid)/enrollments/$(courseId)
            ).data.purchased == true
          )
        );
    }

    /* ============================================================
       COURSE VIDEOS
       
       Path:
       courseVideos/{courseId}/{moduleId}/{lessonId}/{fileName}
       ============================================================ */

    match /courseVideos/{courseId}/{moduleId}/{lessonId}/{fileName} {

      /*
        Students:
          Can read only if enrolled.

        Teacher:
          Can read their own course.

        Admin:
          Can read everything.
      */

      allow read: if
        isAdmin()
        || isCourseOwner(courseId)
        || isEnrolled(courseId);

      /*
        Teacher:
          Can upload/update videos belonging to their own course.

        Admin:
          Can upload/update any course video.

        Maximum:
          500 MB

        Type:
          video/*
      */

      allow write: if
        (isAdmin() || isCourseOwner(courseId))
        && request.resource != null
        && request.resource.size < 500 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');

      /*
        Delete:
          Teacher can delete their own course videos.
          Admin can delete anything.
      */

      allow delete: if
        isAdmin()
        || isCourseOwner(courseId);
    }

    /* ============================================================
       COURSE THUMBNAILS + BANNERS
       
       Path examples:

       courseThumbnails/{courseId}/thumbnail-file
       courseThumbnails/{courseId}/banner-file
       ============================================================ */

    match /courseThumbnails/{courseId}/{allPaths=**} {

      /*
        Marketing images are publicly readable.
      */

      allow read: if true;

      /*
        Teacher:
          Own course only.

        Admin:
          Any course.

        Maximum:
          5 MB

        Type:
          image/*
      */

      allow write: if
        (isAdmin() || isCourseOwner(courseId))
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if
        isAdmin()
        || isCourseOwner(courseId);
    }

    /* ============================================================
       COURSE PREVIEW VIDEOS
       
       Path:
       coursePreviews/{courseId}/{fileName}
       ============================================================ */

    match /coursePreviews/{courseId}/{fileName} {

      /*
        Preview videos are public.
      */

      allow read: if true;

      /*
        Maximum:
          100 MB

        Type:
          video/*
      */

      allow write: if
        (isAdmin() || isCourseOwner(courseId))
        && request.resource != null
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');

      allow delete: if
        isAdmin()
        || isCourseOwner(courseId);
    }

    /* ============================================================
       COURSE RESOURCES
       
       Path:
       courseResources/{courseId}/{moduleId}/{lessonId}/{fileName}
       ============================================================ */

    match /courseResources/{courseId}/{moduleId}/{lessonId}/{fileName} {

      /*
        Resources are available to:
          - Admin
          - Course owner
          - Enrolled student
      */

      allow read: if
        isAdmin()
        || isCourseOwner(courseId)
        || isEnrolled(courseId);

      /*
        Maximum:
          50 MB
      */

      allow write: if
        (isAdmin() || isCourseOwner(courseId))
        && request.resource != null
        && request.resource.size < 50 * 1024 * 1024;

      allow delete: if
        isAdmin()
        || isCourseOwner(courseId);
    }

    /* ============================================================
       EVERYTHING ELSE
       ============================================================ */

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}