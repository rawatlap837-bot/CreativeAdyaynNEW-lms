rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPERS
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isAdmin() {
      return isSignedIn()
        && userDoc().data.role == "admin";
    }

    function isTeacher() {
      return isSignedIn()
        && userDoc().data.role == "teacher";
    }

    function isStudent() {
      return isSignedIn()
        && userDoc().data.role == "student";
    }

    function isCourseOwner(courseId) {
      return isTeacher()
        && get(
          /databases/$(database)/documents/courses/$(courseId)
        ).data.instructorId == request.auth.uid;
    }

    function isEnrolled(courseId) {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/enrollments/$(request.auth.uid + "_" + courseId)
        )
        && get(
          /databases/$(database)/documents/enrollments/$(request.auth.uid + "_" + courseId)
        ).data.status == "active";
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      // User reads own profile
      // Admin reads all profiles
      allow read: if
        isSignedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      // User creates own profile
      allow create: if
        isSignedIn()
        && request.auth.uid == userId;

      // User can update own profile,
      // but cannot change their role.
      // Admin can update anyone.
      allow update: if
        isSignedIn()
        && (
          isAdmin()
          ||
          (
            request.auth.uid == userId
            && request.resource.data.role == resource.data.role
          )
        );

      // Only admin can delete users
      allow delete: if isAdmin();


      // =======================================================
      // LEGACY USER ENROLLMENTS
      // =======================================================

      match /enrollments/{courseId} {

        allow read: if
          isSignedIn()
          && (
            request.auth.uid == userId
            || isAdmin()
          );

        allow create, update: if
          isSignedIn()
          && request.auth.uid == userId;

        allow delete: if isAdmin();
      }
    }


    // =========================================================
    // COURSES
    // =========================================================

    match /courses/{courseId} {

      // =======================================================
      // COURSE READ
      // =======================================================

      // Public:
      //   published courses only
      //
      // Teacher:
      //   own courses
      //
      // Admin:
      //   all courses

      allow read: if
        resource.data.status == "published"
        || isAdmin()
        ||
        (
          isTeacher()
          && resource.data.instructorId == request.auth.uid
        );


      // =======================================================
      // TEACHER CREATE
      // =======================================================

      allow create: if
        isTeacher()
        && request.resource.data.instructorId == request.auth.uid
        && request.resource.data.status == "draft"
        && request.resource.data.featured == false
        && request.resource.data.order == 0;


      // =======================================================
      // TEACHER UPDATE
      // =======================================================

      allow update: if
        isTeacher()
        && resource.data.instructorId == request.auth.uid
        && request.resource.data.instructorId == resource.data.instructorId
        && request.resource.data.featured == resource.data.featured
        && request.resource.data.order == resource.data.order
        && (
          request.resource.data.status == "draft"
          || request.resource.data.status == "pending"
          || request.resource.data.status == "rejected"
        );


      // =======================================================
      // ADMIN COURSE CONTROL
      // =======================================================

      allow update: if isAdmin();


      // =======================================================
      // COURSE DELETE
      // =======================================================

      allow delete: if
        isAdmin()
        ||
        (
          isTeacher()
          && resource.data.instructorId == request.auth.uid
        );


      // =======================================================
      // MODULES
      // =======================================================

      match /modules/{moduleId} {

        // -------------------------------------------------------
        // MODULE READ
        // -------------------------------------------------------

        allow read: if
          get(
            /databases/$(database)/documents/courses/$(courseId)
          ).data.status == "published"
          || isAdmin()
          ||
          (
            isTeacher()
            &&
            get(
              /databases/$(database)/documents/courses/$(courseId)
            ).data.instructorId == request.auth.uid
          );


        // -------------------------------------------------------
        // TEACHER MODULE MANAGEMENT
        // -------------------------------------------------------

        allow create, update, delete: if
          isCourseOwner(courseId)
          &&
          get(
            /databases/$(database)/documents/courses/$(courseId)
          ).data.status != "pending"
          &&
          get(
            /databases/$(database)/documents/courses/$(courseId)
          ).data.status != "archived";


        // -------------------------------------------------------
        // ADMIN MODULE CONTROL
        // -------------------------------------------------------

        allow update, delete: if isAdmin();


        // =======================================================
        // LESSONS
        // =======================================================

        match /lessons/{lessonId} {

          // -----------------------------------------------------
          // LESSON READ
          // -----------------------------------------------------

          allow read: if
            get(
              /databases/$(database)/documents/courses/$(courseId)
            ).data.status == "published"
            || isAdmin()
            ||
            (
              isTeacher()
              &&
              get(
                /databases/$(database)/documents/courses/$(courseId)
              ).data.instructorId == request.auth.uid
            );


          // -----------------------------------------------------
          // TEACHER LESSON MANAGEMENT
          // -----------------------------------------------------

          allow create, update, delete: if
            isCourseOwner(courseId)
            &&
            get(
              /databases/$(database)/documents/courses/$(courseId)
            ).data.status != "pending"
            &&
            get(
              /databases/$(database)/documents/courses/$(courseId)
            ).data.status != "archived";


          // -----------------------------------------------------
          // ADMIN LESSON CONTROL
          // -----------------------------------------------------

          allow update, delete: if isAdmin();
        }
      }
    }


    // =========================================================
    // ENROLLMENTS
    // =========================================================

    match /enrollments/{enrollmentId} {

      // =======================================================
      // GET — SINGLE ENROLLMENT
      // =======================================================

      allow get: if
        isAdmin()
        ||
        (
          isSignedIn()
          && enrollmentId.startsWith(request.auth.uid + "_")
        );


      // =======================================================
      // LIST — MY ENROLLMENTS
      // =======================================================

      allow list: if
        isAdmin()
        ||
        (
          isSignedIn()
          && resource.data.uid == request.auth.uid
        );


      // =======================================================
      // CREATE ENROLLMENT
      // =======================================================

      allow create: if
        isStudent()
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.courseId is string
        && request.resource.data.status in [
          "active",
          "pending"
        ]
        &&
        (
          (
            request.resource.data.status == "active"
            && request.resource.data.paymentStatus == "free"
          )
          ||
          (
            request.resource.data.status == "pending"
            && request.resource.data.paymentStatus == "pending"
          )
        );


      // =======================================================
      // STUDENT PROGRESS UPDATE
      // =======================================================

      allow update: if
        isStudent()
        && resource.data.uid == request.auth.uid

        // Identity cannot change
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.courseId == resource.data.courseId

        // Payment/access state cannot change
        && request.resource.data.status == resource.data.status
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.paymentId == resource.data.paymentId

        // Progress validation
        && request.resource.data.progress >= 0
        && request.resource.data.progress <= 100;


      // =======================================================
      // ADMIN ENROLLMENT CONTROL
      // =======================================================

      allow update, delete: if isAdmin();
    }


    // =========================================================
    // ATTENDANCE
    // =========================================================

    match /attendance/{attendanceId} {

      // =======================================================
      // READ ATTENDANCE
      // =======================================================

      // Admin:
      //   Can read everything.
      //
      // Student:
      //   Can read only their own attendance.
      //
      // Teacher:
      //   Can read attendance belonging to their own courses.

      allow read: if
        isAdmin()
        ||
        (
          isStudent()
          && resource.data.studentId == request.auth.uid
        )
        ||
        (
          isTeacher()
          && isCourseOwner(resource.data.courseId)
        );


      // =======================================================
      // STUDENT MARKS ATTENDANCE
      // =======================================================

      // Student can create ONLY their own attendance.
      //
      // Students can mark themselves PRESENT.
      //
      // They cannot create attendance for:
      // - another student
      // - another user
      // - arbitrary status

      allow create: if
        isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.markedBy == request.auth.uid
        && request.resource.data.courseId is string
        && request.resource.data.sessionId is string
        && request.resource.data.status == "present";


      // =======================================================
      // UPDATE ATTENDANCE
      // =======================================================

      // Student cannot modify attendance after marking.
      //
      // Teacher can update attendance for their own courses.
      //
      // Admin can update everything.

      allow update: if
        isAdmin()
        ||
        (
          isTeacher()
          && isCourseOwner(resource.data.courseId)
        );


      // =======================================================
      // DELETE ATTENDANCE
      // =======================================================

      // Only admin can permanently delete attendance.

      allow delete: if isAdmin();
    }


    // =========================================================
    // PAYMENTS
    // =========================================================

    match /payments/{paymentId} {

      // Student creates own payment
      allow create: if
        isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      // Student reads own payments
      // Admin reads all payments
      allow read: if
        isAdmin()
        ||
        (
          isSignedIn()
          && resource.data.uid == request.auth.uid
        );

      // Only admin can modify/delete payments
      allow update, delete: if isAdmin();
    }


    // =========================================================
    // STUDENTS
    // =========================================================

    match /students/{studentId} {

      // Admin full access
      allow read, write: if isAdmin();

      // Student reads own student record
      allow read: if
        isSignedIn()
        && request.auth.uid == studentId;
    }


    // =========================================================
    // INSTRUCTORS
    // =========================================================

    match /instructors/{instructorId} {

      // Public instructor information
      allow read: if true;

      // Admin manages instructors
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}