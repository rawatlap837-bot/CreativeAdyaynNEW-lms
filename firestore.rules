rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ============================================================
    // AUTH / ROLE HELPERS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isAdmin() {
      return isSignedIn()
        && userDoc().data.role == "admin";
    }

    function isTeacher() {
      return isSignedIn()
        && (
          userDoc().data.role == "teacher"
          || userDoc().data.role == "instructor"
        );
    }

    function isStudent() {
      return isSignedIn()
        && userDoc().data.role == "student";
    }


    // ============================================================
    // COURSE HELPERS
    // ============================================================

    function isCourseOwner(courseId) {
      return isTeacher()
        && exists(
          /databases/$(database)/documents/courses/$(courseId)
        )
        && get(
          /databases/$(database)/documents/courses/$(courseId)
        ).data.instructorId == request.auth.uid;
    }

    function isEnrolled(courseId) {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/enrollments/$(request.auth.uid + "_" + courseId)
        )
        && get(
          /databases/$(database)/documents/enrollments/$(request.auth.uid + "_" + courseId)
        ).data.status == "active";
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      allow read: if
        isSignedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow create: if
        isSignedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow update: if
        isSignedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow delete: if isAdmin();
    }


    // ============================================================
    // COURSES
    // ============================================================

    match /courses/{courseId} {

      allow read: if
        isAdmin()
        || isCourseOwner(courseId)
        || resource.data.status == "published";

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && request.resource.data.instructorId == request.auth.uid
        );

      allow update: if
        isAdmin()
        || (
          isCourseOwner(courseId)
          && request.resource.data.instructorId == request.auth.uid
        );

      allow delete: if
        isAdmin()
        || isCourseOwner(courseId);
    }


    // ============================================================
    // COURSE MODULES
    // ============================================================

    match /courses/{courseId}/modules/{moduleId} {

      allow read: if
        isAdmin()
        || isCourseOwner(courseId)
        || isEnrolled(courseId)
        || (
          isSignedIn() == false
          && get(
            /databases/$(database)/documents/courses/$(courseId)
          ).data.status == "published"
        )
        || (
          isSignedIn()
          && get(
            /databases/$(database)/documents/courses/$(courseId)
          ).data.status == "published"
        );

      allow create: if
        isAdmin()
        || isCourseOwner(courseId);

      allow update: if
        isAdmin()
        || isCourseOwner(courseId);

      allow delete: if
        isAdmin()
        || isCourseOwner(courseId);
    }


    // ============================================================
    // COURSE LESSONS
    // ============================================================

    match /courses/{courseId}/modules/{moduleId}/lessons/{lessonId} {

      allow read: if
        isAdmin()
        || isCourseOwner(courseId)
        || (
          isEnrolled(courseId)
          && resource.data.published == true
        )
        || (
          isSignedIn() == false
          && get(
            /databases/$(database)/documents/courses/$(courseId)
          ).data.status == "published"
          && resource.data.published == true
        );

      allow create: if
        isAdmin()
        || isCourseOwner(courseId);

      allow update: if
        isAdmin()
        || isCourseOwner(courseId);

      allow delete: if
        isAdmin()
        || isCourseOwner(courseId);
    }


    // ============================================================
    // ENROLLMENTS
    //
    // Document ID MUST be `{uid}_{courseId}` — isEnrolled()
    // above depends on this exact ID scheme everywhere it's used
    // (modules, lessons, discussions, attendance, announcements,
    // schedule, tasks, liveClasses).
    //
    // Students can self-enroll ONLY as a direct result of a
    // matching, just-created payment doc for the same uid+course
    // — this is what stands in for server-side verification now
    // that there is no backend. It stops a student from writing
    // an enrollment out of thin air, but NOT from writing a fake
    // "paid" payment doc first (see payments section below for
    // that caveat).
    // ============================================================

    match /enrollments/{enrollmentId} {

      allow read: if
        isAdmin()
        || (
          isStudent()
          && resource.data.uid == request.auth.uid
        )
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        );

      allow create: if
        isAdmin()
        || (
          isStudent()
          && enrollmentId == request.auth.uid + "_" + request.resource.data.courseId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.courseId is string
          && request.resource.data.status == "active"
          && request.resource.data.paymentId is string
          && exists(
            /databases/$(database)/documents/payments/$(request.resource.data.paymentId)
          )
          && get(
            /databases/$(database)/documents/payments/$(request.resource.data.paymentId)
          ).data.userId == request.auth.uid
          && get(
            /databases/$(database)/documents/payments/$(request.resource.data.paymentId)
          ).data.courseId == request.resource.data.courseId
        );

      allow update: if
        isAdmin()
        || (
          isStudent()
          && enrollmentId == request.auth.uid + "_" + resource.data.courseId
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.courseId == resource.data.courseId
          && request.resource.data.status == "active"
          && request.resource.data.lastPaymentId is string
          && exists(
            /databases/$(database)/documents/payments/$(request.resource.data.lastPaymentId)
          )
          && get(
            /databases/$(database)/documents/payments/$(request.resource.data.lastPaymentId)
          ).data.userId == request.auth.uid
          && get(
            /databases/$(database)/documents/payments/$(request.resource.data.lastPaymentId)
          ).data.courseId == resource.data.courseId
        );

      allow delete: if isAdmin();
    }


    // ============================================================
    // ATTENDANCE SESSIONS
    // ============================================================

    match /attendanceSessions/{sessionId} {

      allow read: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.courseId is string
          && resource.data.status == "open"
          && isEnrolled(resource.data.courseId)
        );

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && request.resource.data.courseId is string
          && isCourseOwner(request.resource.data.courseId)
          && request.resource.data.teacherId == request.auth.uid
          && request.resource.data.status == "open"
        );

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.courseId == resource.data.courseId
          && request.resource.data.teacherId == resource.data.teacherId
        );

      allow delete: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
        );
    }


    // ============================================================
    // ATTENDANCE RECORDS
    // ============================================================

    match /attendance/{attendanceId} {

      allow read: if
        isAdmin()
        || (
          isStudent()
          && resource.data.studentId == request.auth.uid
        )
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        );

      allow create: if
        isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.markedBy == request.auth.uid
        && request.resource.data.courseId is string
        && request.resource.data.sessionId is string
        && request.resource.data.status == "present"
        && isEnrolled(request.resource.data.courseId)
        && exists(
          /databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)
        )
        && get(
          /databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)
        ).data.courseId == request.resource.data.courseId
        && get(
          /databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)
        ).data.status == "open";

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.sessionId == resource.data.sessionId
          && request.resource.data.courseId == resource.data.courseId
        );

      allow delete: if isAdmin();
    }


    // ============================================================
    // SCHEDULE
    //
    // ASSUMPTION — confirm real collection/field names against
    // Dashboard.jsx before relying on this:
    //
    // schedule/{scheduleId}
    // {
    //   courseId,
    //   teacherId,
    //   title,
    //   startTime,
    //   endTime,
    //   dayOfWeek / date
    // }
    // ============================================================

    match /schedule/{scheduleId} {

      allow read: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.courseId is string
          && isEnrolled(resource.data.courseId)
        );

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && request.resource.data.courseId is string
          && isCourseOwner(request.resource.data.courseId)
          && request.resource.data.teacherId == request.auth.uid
        );

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.courseId == resource.data.courseId
        );

      allow delete: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
        );
    }


    // ============================================================
    // TASKS (assignments / to-dos)
    //
    // ASSUMPTION — confirm real collection/field names:
    //
    // tasks/{taskId}
    // {
    //   courseId,
    //   teacherId,
    //   title,
    //   dueDate,
    //   status
    // }
    // ============================================================

    match /tasks/{taskId} {

      allow read: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.courseId is string
          && isEnrolled(resource.data.courseId)
        );

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && request.resource.data.courseId is string
          && isCourseOwner(request.resource.data.courseId)
          && request.resource.data.teacherId == request.auth.uid
        );

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.courseId == resource.data.courseId
        );

      allow delete: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
        );
    }


    // ============================================================
    // LIVE CLASSES
    //
    // ASSUMPTION — confirm real collection/field names:
    //
    // liveClasses/{liveClassId}
    // {
    //   courseId,
    //   teacherId,
    //   status: "scheduled" | "live" | "ended",
    //   meetingLink,
    //   startTime
    // }
    // ============================================================

    match /liveClasses/{liveClassId} {

      allow read: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.courseId is string
          && isEnrolled(resource.data.courseId)
        );

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && request.resource.data.courseId is string
          && isCourseOwner(request.resource.data.courseId)
          && request.resource.data.teacherId == request.auth.uid
        );

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.courseId == resource.data.courseId
        );

      allow delete: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
        );
    }


    // ============================================================
    // PAYMENTS
    // ============================================================

    match /payments/{paymentId} {

      allow read: if
        isAdmin()
        || (
          isStudent()
          && resource.data.userId == request.auth.uid
        )
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        );

      allow create: if
        isAdmin()
        || (
          isStudent()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.courseId is string
          && request.resource.data.status == "paid"
        );

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    // ============================================================
    // STUDENTS
    // ============================================================

    match /students/{studentId} {

      allow read: if
        isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == studentId
        )
        || isTeacher();

      allow create: if
        isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == studentId
        );

      allow update: if
        isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == studentId
        );

      allow delete: if isAdmin();
    }


    // ============================================================
    // INSTRUCTORS / TEACHERS
    // ============================================================

    match /instructors/{instructorId} {

      allow read: if isSignedIn();

      allow create: if isAdmin();

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && request.auth.uid == instructorId
        );

      allow delete: if isAdmin();
    }


    // ============================================================
    // ANNOUNCEMENTS
    // ============================================================

    match /announcements/{announcementId} {

      allow read: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.audienceType == "global"
          && resource.data.status == "published"
        )
        || (
          isTeacher()
          && resource.data.audienceType == "course"
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.audienceType == "global"
          && resource.data.status == "published"
        )
        || (
          isStudent()
          && resource.data.audienceType == "course"
          && resource.data.status == "published"
          && resource.data.courseId is string
          && isEnrolled(resource.data.courseId)
        );

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && request.resource.data.audienceType == "course"
          && request.resource.data.courseId is string
          && isCourseOwner(request.resource.data.courseId)
          && request.resource.data.authorId == request.auth.uid
          && (
            request.resource.data.authorRole == "teacher"
            || request.resource.data.authorRole == "instructor"
          )
        );

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.audienceType == "course"
          && resource.data.courseId is string
          && resource.data.authorId == request.auth.uid
          && isCourseOwner(resource.data.courseId)
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.courseId == resource.data.courseId
          && request.resource.data.audienceType == resource.data.audienceType
        );

      allow delete: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.audienceType == "course"
          && resource.data.courseId is string
          && resource.data.authorId == request.auth.uid
          && isCourseOwner(resource.data.courseId)
        );
    }


    // ============================================================
    // DISCUSSIONS
    // ============================================================

    match /discussions/{discussionId} {

      allow read: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.courseId is string
          && isEnrolled(resource.data.courseId)
        );

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && request.resource.data.courseId is string
          && isCourseOwner(request.resource.data.courseId)
          && request.resource.data.authorId == request.auth.uid
        )
        || (
          isStudent()
          && request.resource.data.courseId is string
          && isEnrolled(request.resource.data.courseId)
          && request.resource.data.authorId == request.auth.uid
        );

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.authorId == request.auth.uid
        );

      allow delete: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.authorId == request.auth.uid
        );


      // ==========================================================
      // DISCUSSION REPLIES
      // ==========================================================

      match /replies/{replyId} {

        allow read: if
          isAdmin()
          || (
            isTeacher()
            && get(
              /databases/$(database)/documents/discussions/$(discussionId)
            ).data.courseId is string
            && isCourseOwner(
              get(
                /databases/$(database)/documents/discussions/$(discussionId)
              ).data.courseId
            )
          )
          || (
            isStudent()
            && get(
              /databases/$(database)/documents/discussions/$(discussionId)
            ).data.courseId is string
            && isEnrolled(
              get(
                /databases/$(database)/documents/discussions/$(discussionId)
              ).data.courseId
            )
          );

        allow create: if
          isAdmin()
          || (
            isTeacher()
            && get(
              /databases/$(database)/documents/discussions/$(discussionId)
            ).data.courseId is string
            && isCourseOwner(
              get(
                /databases/$(database)/documents/discussions/$(discussionId)
              ).data.courseId
            )
            && request.resource.data.authorId == request.auth.uid
          )
          || (
            isStudent()
            && get(
              /databases/$(database)/documents/discussions/$(discussionId)
            ).data.courseId is string
            && isEnrolled(
              get(
                /databases/$(database)/documents/discussions/$(discussionId)
              ).data.courseId
            )
            && request.resource.data.authorId == request.auth.uid
          );

        allow update: if
          isAdmin()
          || (
            isSignedIn()
            && resource.data.authorId == request.auth.uid
          );

        allow delete: if
          isAdmin()
          || (
            isSignedIn()
            && resource.data.authorId == request.auth.uid
          );
      }
    }


    // ============================================================
    // NOTIFICATIONS
    // ============================================================

    match /notifications/{notificationId} {

      allow read: if
        isAdmin()
        || (
          isSignedIn()
          && resource.data.recipientId == request.auth.uid
        );

      allow create: if isAdmin();

      allow update: if
        isAdmin()
        || (
          isSignedIn()
          && resource.data.recipientId == request.auth.uid
        );

      allow delete: if
        isAdmin()
        || (
          isSignedIn()
          && resource.data.recipientId == request.auth.uid
        );
    }


    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
