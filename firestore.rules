rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ============================================================
    // AUTH / ROLE HELPERS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isAdmin() {
      return isSignedIn()
        && userDoc().data.role == "admin";
    }

    function isTeacher() {
      return isSignedIn()
        && (
          userDoc().data.role == "teacher"
          || userDoc().data.role == "instructor"
        );
    }

    function isStudent() {
      return isSignedIn()
        && userDoc().data.role == "student";
    }


    // ============================================================
    // COURSE HELPERS
    // ============================================================

    function isCourseOwner(courseId) {
      return isTeacher()
        && exists(
          /databases/$(database)/documents/courses/$(courseId)
        )
        && get(
          /databases/$(database)/documents/courses/$(courseId)
        ).data.instructorId == request.auth.uid;
    }

    function isEnrolled(courseId) {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/enrollments/$(request.auth.uid + "_" + courseId)
        )
        && get(
          /databases/$(database)/documents/enrollments/$(request.auth.uid + "_" + courseId)
        ).data.status == "active";
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      allow read: if
        isSignedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow create: if
        isSignedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow update: if
        isSignedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow delete: if isAdmin();
    }


    // ============================================================
    // COURSES
    // ============================================================

    match /courses/{courseId} {

      // NOTE: read/update/delete check resource.data.instructorId
      // directly instead of calling isCourseOwner(courseId), which
      // re-fetches this same document via get(). That self-referential
      // get() is what was causing "Missing or insufficient permissions"
      // on the teacher's own-courses list query
      // (where("instructorId","==",uid)) in Attendance.jsx — resource.data
      // is already available for free while this rule evaluates, so no
      // extra read is needed. isCourseOwner() itself is untouched and
      // still used by every other collection below (modules, lessons,
      // attendanceSessions, schedule, tasks, liveClasses, payments,
      // discussions), which genuinely need to look up a *different*
      // document's parent course.

      allow read: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.instructorId == request.auth.uid
        )
        || resource.data.status == "published";

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && request.resource.data.instructorId == request.auth.uid
        );

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.instructorId == request.auth.uid
          && request.resource.data.instructorId == request.auth.uid
        );

      allow delete: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.instructorId == request.auth.uid
        );
    }


    // ============================================================
    // COURSE MODULES
    // ============================================================

    match /courses/{courseId}/modules/{moduleId} {

      allow read: if
        isAdmin()
        || isCourseOwner(courseId)
        || isEnrolled(courseId)
        || (
          isSignedIn() == false
          && get(
            /databases/$(database)/documents/courses/$(courseId)
          ).data.status == "published"
        )
        || (
          isSignedIn()
          && get(
            /databases/$(database)/documents/courses/$(courseId)
          ).data.status == "published"
        );

      allow create: if
        isAdmin()
        || isCourseOwner(courseId);

      allow update: if
        isAdmin()
        || isCourseOwner(courseId);

      allow delete: if
        isAdmin()
        || isCourseOwner(courseId);
    }


    // ============================================================
    // COURSE LESSONS
    // ============================================================

    match /courses/{courseId}/modules/{moduleId}/lessons/{lessonId} {

      allow read: if
        isAdmin()
        || isCourseOwner(courseId)
        || (
          isEnrolled(courseId)
          && resource.data.published == true
        )
        || (
          isSignedIn() == false
          && get(
            /databases/$(database)/documents/courses/$(courseId)
          ).data.status == "published"
          && resource.data.published == true
        );

      allow create: if
        isAdmin()
        || isCourseOwner(courseId);

      allow update: if
        isAdmin()
        || isCourseOwner(courseId);

      allow delete: if
        isAdmin()
        || isCourseOwner(courseId);
    }


// ============================================================
// ENROLLMENTS
// Document ID: {uid}_{courseId}
// ============================================================

match /enrollments/{enrollmentId} {

  // Lets getEnrollment() return null when a student has not
  // enrolled yet, instead of returning permission-denied.
  allow get: if
    isAdmin()
    || (
      isStudent()
      && enrollmentId.matches("^" + request.auth.uid + "_.*")
    )
    || (
      isTeacher()
      && resource.data.courseId is string
      && isCourseOwner(resource.data.courseId)
    );

  // Used by getMyEnrollments(), which queries:
  // where("uid", "==", currentUser.uid)
  allow list: if
    isAdmin()
    || (
      isStudent()
      && resource.data.uid == request.auth.uid
    )
    || (
      isTeacher()
      && resource.data.courseId is string
      && isCourseOwner(resource.data.courseId)
    );

  // Used by enrollStudent()
  allow create: if
    isAdmin()
    || (
      isStudent()
      && enrollmentId ==
        request.auth.uid + "_" + request.resource.data.courseId
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.studentId == request.auth.uid
      && request.resource.data.courseId is string
      && request.resource.data.status == "active"
      && request.resource.data.paymentStatus in ["free", "paid"]
      && request.resource.data.paymentId is string
      && request.resource.data.progress == 0
    );

  // Students can update only their learning progress.
  allow update: if
    isAdmin()
    || (
      isStudent()
      && resource.data.uid == request.auth.uid
      && request.resource.data.uid == resource.data.uid
      && request.resource.data.studentId == resource.data.studentId
      && request.resource.data.courseId == resource.data.courseId
      && request.resource.data.status == resource.data.status
      && request.resource.data.paymentStatus ==
        resource.data.paymentStatus
      && request.resource.data.paymentId ==
        resource.data.paymentId
      && request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          "completedLessons",
          "progress",
          "lastLessonId",
          "lastAccessedAt",
          "updatedAt"
        ])
    );

  allow delete: if isAdmin();
}
    // ============================================================
    // ATTENDANCE SESSIONS
    // ============================================================

    match /attendanceSessions/{sessionId} {

      allow read: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.courseId is string
          && resource.data.status == "open"
          && isEnrolled(resource.data.courseId)
        );

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && request.resource.data.courseId is string
          && isCourseOwner(request.resource.data.courseId)
          && request.resource.data.teacherId == request.auth.uid
          && request.resource.data.status == "open"
        );

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.courseId == resource.data.courseId
          && request.resource.data.teacherId == resource.data.teacherId
        );

      allow delete: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
        );
    }


    // ============================================================
    // ATTENDANCE RECORDS
    // ============================================================

    match /attendance/{attendanceId} {

      allow read: if
        isAdmin()
        || (
          isStudent()
          && resource.data.studentId == request.auth.uid
        )
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        );

      allow create: if
        isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.markedBy == request.auth.uid
        && request.resource.data.courseId is string
        && request.resource.data.sessionId is string
        && request.resource.data.status == "present"
        && isEnrolled(request.resource.data.courseId)
        && exists(
          /databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)
        )
        && get(
          /databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)
        ).data.courseId == request.resource.data.courseId
        && get(
          /databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)
        ).data.status == "open";

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.sessionId == resource.data.sessionId
          && request.resource.data.courseId == resource.data.courseId
        );

      allow delete: if isAdmin();
    }


    // ============================================================
    // SCHEDULE (course-scoped — created/managed by teachers per course)
    // ============================================================

    match /schedule/{scheduleId} {

      allow read: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.courseId is string
          && isEnrolled(resource.data.courseId)
        );

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && request.resource.data.courseId is string
          && isCourseOwner(request.resource.data.courseId)
          && request.resource.data.teacherId == request.auth.uid
        );

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.courseId == resource.data.courseId
        );

      allow delete: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
        );
    }


    // ============================================================
    // SCHEDULE EVENTS (personal per-student calendar)
    //
    // This is a DIFFERENT collection from /schedule above.
    // Dashboard.jsx's "This week" panel queries:
    //   collection(db, "scheduleEvents")
    //     .where("uid", "==", currentUser.uid)
    //     .where("date", ">=", weekStart)
    //     .where("date", "<=", weekEnd)
    // i.e. a personal, non-course-scoped event list — there was no
    // rule at all for this collection name before, so every read
    // fell through to the default-deny catch-all at the bottom of
    // this file.
    // ============================================================

    match /scheduleEvents/{eventId} {

      allow read: if
        isAdmin()
        || (
          isStudent()
          && resource.data.uid == request.auth.uid
        )
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        );

      allow create: if
        isAdmin()
        || (
          isStudent()
          && request.resource.data.uid == request.auth.uid
        )
        || (
          isTeacher()
          && request.resource.data.courseId is string
          && isCourseOwner(request.resource.data.courseId)
        );

      allow update: if
        isAdmin()
        || (
          isStudent()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
        )
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        );

      allow delete: if
        isAdmin()
        || (
          isStudent()
          && resource.data.uid == request.auth.uid
        )
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        );
    }


    // ============================================================
    // TASKS
    //
    // Two shapes coexist here:
    //  - Course assignments set by a teacher: { courseId, teacherId, ... }
    //  - Personal per-student to-dos, which is what Dashboard.jsx's
    //    "Today's tasks" panel actually reads/writes:
    //      collection(db, "tasks").where("uid","==",uid).where("date", ...)
    //    and toggleTask() calls updateDoc(doc(db,"tasks",id), { progress }).
    //    The original rule only recognised the course-assignment shape,
    //    so every personal task read/update was denied.
    // ============================================================

    match /tasks/{taskId} {

      allow read: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.courseId is string
          && isEnrolled(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.uid == request.auth.uid
        );

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && request.resource.data.courseId is string
          && isCourseOwner(request.resource.data.courseId)
          && request.resource.data.teacherId == request.auth.uid
        )
        || (
          isStudent()
          && request.resource.data.uid == request.auth.uid
        );

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.courseId == resource.data.courseId
        )
        || (
          // Students may only ever touch their own personal task's
          // progress fields — never reassign it to someone else.
          isStudent()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
        );

      allow delete: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
        )
        || (
          isStudent()
          && resource.data.uid == request.auth.uid
        );
    }


    // ============================================================
    // LIVE CLASSES
    //
    // Same dual-shape situation as tasks/scheduleEvents above.
    // Dashboard.jsx's "Live class" card queries:
    //   collection(db, "liveClasses")
    //     .where("uid","==",uid)
    //     .where("startTime",">=",now)
    // and setLiveClassStatus() updates only the "status" field
    // (join / request reschedule) on the student's own doc.
    // ============================================================

    match /liveClasses/{liveClassId} {

      allow read: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.courseId is string
          && isEnrolled(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.uid == request.auth.uid
        );

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && request.resource.data.courseId is string
          && isCourseOwner(request.resource.data.courseId)
          && request.resource.data.teacherId == request.auth.uid
        );

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.courseId == resource.data.courseId
        )
        || (
          // A student may only flip their own doc's "status" field
          // (e.g. "joined" / "rescheduled") — nothing else.
          isStudent()
          && resource.data.uid == request.auth.uid
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly(["status"])
        );

      allow delete: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
        );
    }


    // ============================================================
    // PAYMENTS
    // ============================================================

    match /payments/{paymentId} {

      allow read: if
        isAdmin()
        || (
          isStudent()
          && resource.data.userId == request.auth.uid
        )
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        );

      allow create: if
        isAdmin()
        || (
          isStudent()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.courseId is string
          && request.resource.data.status == "paid"
        );

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    // ============================================================
    // STUDENTS
    // ============================================================

    match /students/{studentId} {

      allow read: if
        isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == studentId
        )
        || isTeacher();

      allow create: if
        isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == studentId
        );

      allow update: if
        isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == studentId
        );

      allow delete: if isAdmin();
    }


    // ============================================================
    // INSTRUCTORS / TEACHERS
    // ============================================================

    match /instructors/{instructorId} {

      allow read: if isSignedIn();

      allow create: if isAdmin();

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && request.auth.uid == instructorId
        );

      allow delete: if isAdmin();
    }


    // ============================================================
    // ANNOUNCEMENTS
    // ============================================================

    match /announcements/{announcementId} {

      allow read: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.audienceType == "global"
          && resource.data.status == "published"
        )
        || (
          isTeacher()
          && resource.data.audienceType == "course"
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.audienceType == "global"
          && resource.data.status == "published"
        )
        || (
          isStudent()
          && resource.data.audienceType == "course"
          && resource.data.status == "published"
          && resource.data.courseId is string
          && isEnrolled(resource.data.courseId)
        );

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && request.resource.data.audienceType == "course"
          && request.resource.data.courseId is string
          && isCourseOwner(request.resource.data.courseId)
          && request.resource.data.authorId == request.auth.uid
          && (
            request.resource.data.authorRole == "teacher"
            || request.resource.data.authorRole == "instructor"
          )
        );

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.audienceType == "course"
          && resource.data.courseId is string
          && resource.data.authorId == request.auth.uid
          && isCourseOwner(resource.data.courseId)
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.courseId == resource.data.courseId
          && request.resource.data.audienceType == resource.data.audienceType
        );

      allow delete: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.audienceType == "course"
          && resource.data.courseId is string
          && resource.data.authorId == request.auth.uid
          && isCourseOwner(resource.data.courseId)
        );
    }


    // ============================================================
    // DISCUSSIONS
    // ============================================================

    match /discussions/{discussionId} {

      allow read: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.courseId is string
          && isEnrolled(resource.data.courseId)
        );

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && request.resource.data.courseId is string
          && isCourseOwner(request.resource.data.courseId)
          && request.resource.data.authorId == request.auth.uid
        )
        || (
          isStudent()
          && request.resource.data.courseId is string
          && isEnrolled(request.resource.data.courseId)
          && request.resource.data.authorId == request.auth.uid
        );

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.authorId == request.auth.uid
        );

      allow delete: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.authorId == request.auth.uid
        );


      // ==========================================================
      // DISCUSSION REPLIES
      // ==========================================================

      match /replies/{replyId} {

        allow read: if
          isAdmin()
          || (
            isTeacher()
            && get(
              /databases/$(database)/documents/discussions/$(discussionId)
            ).data.courseId is string
            && isCourseOwner(
              get(
                /databases/$(database)/documents/discussions/$(discussionId)
              ).data.courseId
            )
          )
          || (
            isStudent()
            && get(
              /databases/$(database)/documents/discussions/$(discussionId)
            ).data.courseId is string
            && isEnrolled(
              get(
                /databases/$(database)/documents/discussions/$(discussionId)
              ).data.courseId
            )
          );

        allow create: if
          isAdmin()
          || (
            isTeacher()
            && get(
              /databases/$(database)/documents/discussions/$(discussionId)
            ).data.courseId is string
            && isCourseOwner(
              get(
                /databases/$(database)/documents/discussions/$(discussionId)
              ).data.courseId
            )
            && request.resource.data.authorId == request.auth.uid
          )
          || (
            isStudent()
            && get(
              /databases/$(database)/documents/discussions/$(discussionId)
            ).data.courseId is string
            && isEnrolled(
              get(
                /databases/$(database)/documents/discussions/$(discussionId)
              ).data.courseId
            )
            && request.resource.data.authorId == request.auth.uid
          );

        allow update: if
          isAdmin()
          || (
            isSignedIn()
            && resource.data.authorId == request.auth.uid
          );

        allow delete: if
          isAdmin()
          || (
            isSignedIn()
            && resource.data.authorId == request.auth.uid
          );
      }
    }


    // ============================================================
    // NOTIFICATIONS
    // ============================================================

    match /notifications/{notificationId} {

      allow read: if
        isAdmin()
        || (
          isSignedIn()
          && resource.data.recipientId == request.auth.uid
        );

      allow create: if isAdmin();

      allow update: if
        isAdmin()
        || (
          isSignedIn()
          && resource.data.recipientId == request.auth.uid
        );

      allow delete: if
        isAdmin()
        || (
          isSignedIn()
          && resource.data.recipientId == request.auth.uid
        );
    }


    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
