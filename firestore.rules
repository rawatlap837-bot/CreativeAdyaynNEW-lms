rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ============================================================
    // AUTH / ROLE HELPERS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isAdmin() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && userDoc().data.role == "admin";
    }

    function isTeacher() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && (
          userDoc().data.role == "teacher"
          || userDoc().data.role == "instructor"
        );
    }

    function isStudent() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && userDoc().data.role == "student";
    }


    // ============================================================
    // COURSE HELPERS
    // ============================================================

    function isCourseOwner(courseId) {
      return isTeacher()
        && exists(
          /databases/$(database)/documents/courses/$(courseId)
        )
        && get(
          /databases/$(database)/documents/courses/$(courseId)
        ).data.instructorId == request.auth.uid;
    }

    // Single source of truth for "is the parent course published".
    // Used by modules + lessons so we're not doing 2-3 separate
    // get() calls per document during list queries.
    function isCoursePublished(courseId) {
      return exists(
        /databases/$(database)/documents/courses/$(courseId)
      )
      && get(
        /databases/$(database)/documents/courses/$(courseId)
      ).data.status == "published";
    }

    function isEnrolled(courseId) {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/enrollments/$(request.auth.uid + "_" + courseId)
        )
        && get(
          /databases/$(database)/documents/enrollments/$(request.auth.uid + "_" + courseId)
        ).data.status == "active";
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      allow read: if
        isSignedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow create: if
        isSignedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow update: if
        isSignedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow delete: if isAdmin();
    }


    // ============================================================
    // COURSES
    // ============================================================

    match /courses/{courseId} {

      allow read: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.instructorId == request.auth.uid
        )
        || resource.data.status == "published";

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && request.resource.data.instructorId == request.auth.uid
        );

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.instructorId == request.auth.uid
          && request.resource.data.instructorId == request.auth.uid
        );

      allow delete: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.instructorId == request.auth.uid
        );
    }


    // ============================================================
    // COURSE MODULES
    //
    // Anyone (signed in or not) can read modules of a published
    // course. Owners/enrolled students can read regardless of
    // publish state (e.g. drafts, or a course that was unpublished
    // after they enrolled).
    // ============================================================

    match /courses/{courseId}/modules/{moduleId} {

      allow read: if
        isAdmin()
        || isCourseOwner(courseId)
        || isEnrolled(courseId)
        || isCoursePublished(courseId);

      allow create: if
        isAdmin()
        || isCourseOwner(courseId);

      allow update: if
        isAdmin()
        || isCourseOwner(courseId);

      allow delete: if
        isAdmin()
        || isCourseOwner(courseId);
    }


    // ============================================================
    // COURSE LESSONS
    //
    // Owners/enrolled students can always read.
    // Everyone else (signed in or not) can read a lesson ONLY if
    // BOTH the parent course is published AND the lesson itself
    // is flagged published (e.g. free preview lessons).
    // ============================================================

    match /courses/{courseId}/modules/{moduleId}/lessons/{lessonId} {

      allow read: if
        isAdmin()
        || isCourseOwner(courseId)
        || isEnrolled(courseId)
        || (
          isCoursePublished(courseId)
          && resource.data.published == true
        );

      allow create: if
        isAdmin()
        || isCourseOwner(courseId);

      allow update: if
        isAdmin()
        || isCourseOwner(courseId);

      allow delete: if
        isAdmin()
        || isCourseOwner(courseId);
    }


    // ============================================================
    // ENROLLMENTS
    // Document ID: {uid}_{courseId}
    // ============================================================

    match /enrollments/{enrollmentId} {

      allow get: if
        isAdmin()
        || (
          isStudent()
          && enrollmentId.matches("^" + request.auth.uid + "_.*")
        )
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        );

      allow list: if
        isAdmin()
        || (
          isStudent()
          && resource.data.uid == request.auth.uid
        )
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        );

      allow create: if
        isAdmin()
        || (
          isStudent()
          && enrollmentId ==
            request.auth.uid + "_" + request.resource.data.courseId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.studentId == request.auth.uid
          && request.resource.data.courseId is string
          && request.resource.data.status == "active"
          && request.resource.data.paymentStatus in ["free", "paid"]
          && request.resource.data.paymentId is string
          && request.resource.data.progress == 0
        );

      allow update: if
        isAdmin()
        || (
          isStudent()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.courseId == resource.data.courseId
          && request.resource.data.status == resource.data.status
          && request.resource.data.paymentStatus ==
            resource.data.paymentStatus
          && request.resource.data.paymentId ==
            resource.data.paymentId
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "completedLessons",
              "progress",
              "lastLessonId",
              "lastAccessedAt",
              "updatedAt"
            ])
        );

      allow delete: if isAdmin();
    }


    // ============================================================
    // ASSIGNMENTS
    // ============================================================

    match /assignments/{assignmentId} {

      allow read: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.courseId is string
          && resource.data.status == "published"
          && isEnrolled(resource.data.courseId)
        );

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && request.resource.data.courseId is string
          && request.resource.data.teacherId == request.auth.uid
          && isCourseOwner(request.resource.data.courseId)
        );

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && resource.data.teacherId == request.auth.uid
          && isCourseOwner(resource.data.courseId)
          && request.resource.data.courseId == resource.data.courseId
          && request.resource.data.teacherId == resource.data.teacherId
        );

      allow delete: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && resource.data.teacherId == request.auth.uid
          && isCourseOwner(resource.data.courseId)
        );
    }


    // ============================================================
    // ASSIGNMENT SUBMISSIONS
    // Path: /assignments/{assignmentId}/submissions/{studentId}
    // ============================================================

    match /assignments/{assignmentId}/submissions/{studentId} {

      allow read: if
        isAdmin()
        || (
          isTeacher()
          && exists(
            /databases/$(database)/documents/assignments/$(assignmentId)
          )
          && get(
            /databases/$(database)/documents/assignments/$(assignmentId)
          ).data.courseId is string
          && isCourseOwner(
            get(
              /databases/$(database)/documents/assignments/$(assignmentId)
            ).data.courseId
          )
        )
        || (
          isStudent()
          && studentId == request.auth.uid
        );

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && exists(
            /databases/$(database)/documents/assignments/$(assignmentId)
          )
          && get(
            /databases/$(database)/documents/assignments/$(assignmentId)
          ).data.courseId is string
          && isCourseOwner(
            get(
              /databases/$(database)/documents/assignments/$(assignmentId)
            ).data.courseId
          )
        )
        || (
          isStudent()
          && studentId == request.auth.uid
          && exists(
            /databases/$(database)/documents/assignments/$(assignmentId)
          )
          && get(
            /databases/$(database)/documents/assignments/$(assignmentId)
          ).data.courseId is string
          && get(
            /databases/$(database)/documents/assignments/$(assignmentId)
          ).data.status == "published"
          && isEnrolled(
            get(
              /databases/$(database)/documents/assignments/$(assignmentId)
            ).data.courseId
          )
          && request.resource.data.studentId == request.auth.uid
          && (
            !("grade" in request.resource.data)
            || request.resource.data.grade == null
          )
          && (
            !("feedback" in request.resource.data)
            || request.resource.data.feedback == ""
            || request.resource.data.feedback == null
          )
          && (
            !("gradedAt" in request.resource.data)
            || request.resource.data.gradedAt == null
          )
          && (
            !("gradedBy" in request.resource.data)
            || request.resource.data.gradedBy == null
          )
        );

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && exists(
            /databases/$(database)/documents/assignments/$(assignmentId)
          )
          && get(
            /databases/$(database)/documents/assignments/$(assignmentId)
          ).data.courseId is string
          && isCourseOwner(
            get(
              /databases/$(database)/documents/assignments/$(assignmentId)
            ).data.courseId
          )
          && request.resource.data.studentId == resource.data.studentId
        )
        || (
          isStudent()
          && studentId == request.auth.uid
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.get("grade", null) == resource.data.get("grade", null)
          && request.resource.data.get("feedback", "") == resource.data.get("feedback", "")
          && request.resource.data.get("gradedAt", null) == resource.data.get("gradedAt", null)
          && request.resource.data.get("gradedBy", null) == resource.data.get("gradedBy", null)
        );

      allow delete: if
        isAdmin()
        || (
          isTeacher()
          && exists(
            /databases/$(database)/documents/assignments/$(assignmentId)
          )
          && get(
            /databases/$(database)/documents/assignments/$(assignmentId)
          ).data.courseId is string
          && isCourseOwner(
            get(
              /databases/$(database)/documents/assignments/$(assignmentId)
            ).data.courseId
          )
        )
        || (
          isStudent()
          && studentId == request.auth.uid
        );
    }


    // ============================================================
    // ATTENDANCE SESSIONS
    // ============================================================

    match /attendanceSessions/{sessionId} {

      allow read: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.courseId is string
          && resource.data.status == "open"
          && isEnrolled(resource.data.courseId)
        );

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && request.resource.data.courseId is string
          && isCourseOwner(request.resource.data.courseId)
          && request.resource.data.teacherId == request.auth.uid
          && request.resource.data.status == "open"
        );

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.courseId == resource.data.courseId
          && request.resource.data.teacherId == resource.data.teacherId
        );

      allow delete: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
        );
    }


    // ============================================================
    // ATTENDANCE RECORDS
    // ============================================================

    match /attendance/{attendanceId} {

      allow read: if
        isAdmin()
        || (
          isStudent()
          && resource.data.studentId == request.auth.uid
        )
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        );

      allow create: if
        isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.markedBy == request.auth.uid
        && request.resource.data.courseId is string
        && request.resource.data.sessionId is string
        && request.resource.data.status == "present"
        && isEnrolled(request.resource.data.courseId)
        && exists(
          /databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)
        )
        && get(
          /databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)
        ).data.courseId == request.resource.data.courseId
        && get(
          /databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)
        ).data.status == "open";

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.sessionId == resource.data.sessionId
          && request.resource.data.courseId == resource.data.courseId
        );

      allow delete: if isAdmin();
    }


    // ============================================================
    // SCHEDULE
    // ============================================================

    match /schedule/{scheduleId} {

      allow read: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.courseId is string
          && isEnrolled(resource.data.courseId)
        );

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && request.resource.data.courseId is string
          && isCourseOwner(request.resource.data.courseId)
          && request.resource.data.teacherId == request.auth.uid
        );

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.courseId == resource.data.courseId
        );

      allow delete: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
        );
    }


    // ============================================================
    // SCHEDULE EVENTS
    // ============================================================

    match /scheduleEvents/{eventId} {

      allow read: if
        isAdmin()
        || (
          isStudent()
          && resource.data.uid == request.auth.uid
        )
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        );

      allow create: if
        isAdmin()
        || (
          isStudent()
          && request.resource.data.uid == request.auth.uid
        )
        || (
          isTeacher()
          && request.resource.data.courseId is string
          && isCourseOwner(request.resource.data.courseId)
        );

      allow update: if
        isAdmin()
        || (
          isStudent()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
        )
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        );

      allow delete: if
        isAdmin()
        || (
          isStudent()
          && resource.data.uid == request.auth.uid
        )
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        );
    }


    // ============================================================
    // TASKS
    // ============================================================

    match /tasks/{taskId} {

      allow read: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.courseId is string
          && isEnrolled(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.uid == request.auth.uid
        );

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && request.resource.data.courseId is string
          && isCourseOwner(request.resource.data.courseId)
          && request.resource.data.teacherId == request.auth.uid
        )
        || (
          isStudent()
          && request.resource.data.uid == request.auth.uid
        );

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.courseId == resource.data.courseId
        )
        || (
          isStudent()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
        );

      allow delete: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
        )
        || (
          isStudent()
          && resource.data.uid == request.auth.uid
        );
    }


    // ============================================================
    // LIVE CLASSES
    // ============================================================

    match /liveClasses/{liveClassId} {

      allow read: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.courseId is string
          && isEnrolled(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.uid == request.auth.uid
        );

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && request.resource.data.courseId is string
          && isCourseOwner(request.resource.data.courseId)
          && request.resource.data.teacherId == request.auth.uid
        );

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.courseId == resource.data.courseId
        )
        || (
          isStudent()
          && resource.data.uid == request.auth.uid
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly(["status"])
        );

      allow delete: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
        );
    }


    // ============================================================
    // PAYMENTS
    // ============================================================

    match /payments/{paymentId} {

      allow read: if
        isAdmin()
        || (
          isStudent()
          && resource.data.userId == request.auth.uid
        )
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        );

      allow create: if
        isAdmin()
        || (
          isStudent()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.courseId is string
          && request.resource.data.status == "paid"
        );

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    // ============================================================
    // STUDENTS
    // ============================================================

    match /students/{studentId} {

      allow read: if
        isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == studentId
        )
        || isTeacher();

      allow create: if
        isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == studentId
        );

      allow update: if
        isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == studentId
        );

      allow delete: if isAdmin();
    }


    // ============================================================
    // INSTRUCTORS / TEACHERS
    // ============================================================

    match /instructors/{instructorId} {

      allow read: if isSignedIn();

      allow create: if isAdmin();

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && request.auth.uid == instructorId
        );

      allow delete: if isAdmin();
    }


    // ============================================================
    // ANNOUNCEMENTS
    // ============================================================

    match /announcements/{announcementId} {

      allow read: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.audienceType == "global"
          && resource.data.status == "published"
        )
        || (
          isTeacher()
          && resource.data.audienceType == "course"
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.audienceType == "global"
          && resource.data.status == "published"
        )
        || (
          isStudent()
          && resource.data.audienceType == "course"
          && resource.data.status == "published"
          && resource.data.courseId is string
          && isEnrolled(resource.data.courseId)
        );

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && request.resource.data.audienceType == "course"
          && request.resource.data.courseId is string
          && isCourseOwner(request.resource.data.courseId)
          && request.resource.data.authorId == request.auth.uid
          && (
            request.resource.data.authorRole == "teacher"
            || request.resource.data.authorRole == "instructor"
          )
        );

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.audienceType == "course"
          && resource.data.courseId is string
          && resource.data.authorId == request.auth.uid
          && isCourseOwner(resource.data.courseId)
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.courseId == resource.data.courseId
          && request.resource.data.audienceType == resource.data.audienceType
        );

      allow delete: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.audienceType == "course"
          && resource.data.courseId is string
          && resource.data.authorId == request.auth.uid
          && isCourseOwner(resource.data.courseId)
        );
    }


    // ============================================================
    // DISCUSSIONS
    // ============================================================

    match /discussions/{discussionId} {

      allow read: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.courseId is string
          && isEnrolled(resource.data.courseId)
        );

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && request.resource.data.courseId is string
          && isCourseOwner(request.resource.data.courseId)
          && request.resource.data.authorId == request.auth.uid
        )
        || (
          isStudent()
          && request.resource.data.courseId is string
          && isEnrolled(request.resource.data.courseId)
          && request.resource.data.authorId == request.auth.uid
        );

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.authorId == request.auth.uid
        );

      allow delete: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.authorId == request.auth.uid
        );


      // ==========================================================
      // DISCUSSION REPLIES
      // ==========================================================

      match /replies/{replyId} {

        allow read: if
          isAdmin()
          || (
            isTeacher()
            && get(
              /databases/$(database)/documents/discussions/$(discussionId)
            ).data.courseId is string
            && isCourseOwner(
              get(
                /databases/$(database)/documents/discussions/$(discussionId)
              ).data.courseId
            )
          )
          || (
            isStudent()
            && get(
              /databases/$(database)/documents/discussions/$(discussionId)
            ).data.courseId is string
            && isEnrolled(
              get(
                /databases/$(database)/documents/discussions/$(discussionId)
              ).data.courseId
            )
          );

        allow create: if
          isAdmin()
          || (
            isTeacher()
            && get(
              /databases/$(database)/documents/discussions/$(discussionId)
            ).data.courseId is string
            && isCourseOwner(
              get(
                /databases/$(database)/documents/discussions/$(discussionId)
              ).data.courseId
            )
            && request.resource.data.authorId == request.auth.uid
          )
          || (
            isStudent()
            && get(
              /databases/$(database)/documents/discussions/$(discussionId)
            ).data.courseId is string
            && isEnrolled(
              get(
                /databases/$(database)/documents/discussions/$(discussionId)
              ).data.courseId
            )
            && request.resource.data.authorId == request.auth.uid
          );

        allow update: if
          isAdmin()
          || (
            isSignedIn()
            && resource.data.authorId == request.auth.uid
          );

        allow delete: if
          isAdmin()
          || (
            isSignedIn()
            && resource.data.authorId == request.auth.uid
          );
      }
    }


    // ============================================================
    // NOTIFICATIONS
    // ============================================================

    match /notifications/{notificationId} {

      allow read: if
        isAdmin()
        || (
          isSignedIn()
          && resource.data.recipientId == request.auth.uid
        );

      allow create: if isAdmin();

      allow update: if
        isAdmin()
        || (
          isSignedIn()
          && resource.data.recipientId == request.auth.uid
        );

      allow delete: if
        isAdmin()
        || (
          isSignedIn()
          && resource.data.recipientId == request.auth.uid
        );
    }


    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
