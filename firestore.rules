rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ============================================================
    // AUTH / ROLE HELPERS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isAdmin() {
      return isSignedIn()
        && userDoc().data.role == "admin";
    }

    function isTeacher() {
      return isSignedIn()
        && (
          userDoc().data.role == "teacher"
          || userDoc().data.role == "instructor"
        );
    }

    function isStudent() {
      return isSignedIn()
        && userDoc().data.role == "student";
    }


    // ============================================================
    // COURSE HELPERS
    // ============================================================

    function isCourseOwner(courseId) {
      return isTeacher()
        && exists(
          /databases/$(database)/documents/courses/$(courseId)
        )
        && get(
          /databases/$(database)/documents/courses/$(courseId)
        ).data.instructorId == request.auth.uid;
    }

    function isEnrolled(courseId) {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/enrollments/$(request.auth.uid + "_" + courseId)
        )
        && get(
          /databases/$(database)/documents/enrollments/$(request.auth.uid + "_" + courseId)
        ).data.status == "active";
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      allow read: if
        isSignedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow create: if
        isSignedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow update: if
        isSignedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow delete: if isAdmin();
    }


    // ============================================================
    // COURSES
    // ============================================================

    match /courses/{courseId} {

      allow read: if
        isAdmin()
        || isCourseOwner(courseId)
        || resource.data.status == "published";

      allow create: if
        isAdmin()
        || (
          isTeacher()
          && request.resource.data.instructorId == request.auth.uid
        );

      allow update: if
        isAdmin()
        || (
          isCourseOwner(courseId)
          && request.resource.data.instructorId == request.auth.uid
        );

      allow delete: if
        isAdmin()
        || isCourseOwner(courseId);
    }


    // ============================================================
    // COURSE MODULES
    // ============================================================

    match /courses/{courseId}/modules/{moduleId} {

      allow read: if
        isAdmin()
        || isCourseOwner(courseId)
        || isEnrolled(courseId)
        || (
          isSignedIn() == false
          && get(
            /databases/$(database)/documents/courses/$(courseId)
          ).data.status == "published"
        )
        || (
          isSignedIn()
          && get(
            /databases/$(database)/documents/courses/$(courseId)
          ).data.status == "published"
        );

      allow create: if
        isAdmin()
        || isCourseOwner(courseId);

      allow update: if
        isAdmin()
        || isCourseOwner(courseId);

      allow delete: if
        isAdmin()
        || isCourseOwner(courseId);
    }


    // ============================================================
    // COURSE LESSONS
    // ============================================================

    match /courses/{courseId}/modules/{moduleId}/lessons/{lessonId} {

      allow read: if
        isAdmin()
        || isCourseOwner(courseId)
        || (
          isEnrolled(courseId)
          && resource.data.published == true
        )
        || (
          isSignedIn() == false
          && get(
            /databases/$(database)/documents/courses/$(courseId)
          ).data.status == "published"
          && resource.data.published == true
        );

      allow create: if
        isAdmin()
        || isCourseOwner(courseId);

      allow update: if
        isAdmin()
        || isCourseOwner(courseId);

      allow delete: if
        isAdmin()
        || isCourseOwner(courseId);
    }


    // ============================================================
    // ENROLLMENTS
    // ============================================================

    match /enrollments/{enrollmentId} {

      allow read: if
        isAdmin()
        || (
          isStudent()
          && resource.data.uid == request.auth.uid
        )
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        );

      // Trusted backend/admin creates enrollments
      allow create: if isAdmin();

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    // ============================================================
    // ATTENDANCE SESSIONS
    //
    // Structure:
    //
    // attendanceSessions/{sessionId}
    //
    // {
    //   courseId,
    //   teacherId,
    //   title,
    //   date,
    //   status: "open" | "closed",
    //   createdAt,
    //   updatedAt
    // }
    // ============================================================

    match /attendanceSessions/{sessionId} {

      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------

      allow read: if
        // Admin can see every session
        isAdmin()

        // Teacher can see sessions for their own courses
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )

        // Student can only see OPEN sessions
        // for courses they are actively enrolled in
        || (
          isStudent()
          && resource.data.courseId is string
          && resource.data.status == "open"
          && isEnrolled(resource.data.courseId)
        );


      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------

      allow create: if
        // Admin can create any session
        isAdmin()

        // Teacher can create only for their own course
        || (
          isTeacher()
          && request.resource.data.courseId is string
          && isCourseOwner(request.resource.data.courseId)
          && request.resource.data.teacherId == request.auth.uid
          && request.resource.data.status == "open"
        );


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------

      allow update: if
        // Admin can update anything
        isAdmin()

        // Teacher can update their own course session
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.courseId == resource.data.courseId
          && request.resource.data.teacherId == resource.data.teacherId
        );


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if
        isAdmin()

        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
          && resource.data.teacherId == request.auth.uid
        );
    }


    // ============================================================
    // ATTENDANCE RECORDS
    //
    // Structure:
    //
    // attendance/{sessionId_studentId}
    //
    // {
    //   sessionId,
    //   courseId,
    //   studentId,
    //   status,
    //   markedAt,
    //   markedBy
    // }
    // ============================================================

    match /attendance/{attendanceId} {

      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------

      allow read: if
        // Admin sees everything
        isAdmin()

        // Student sees ONLY their own attendance
        || (
          isStudent()
          && resource.data.studentId == request.auth.uid
        )

        // Teacher sees attendance for their own course
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        );


      // ----------------------------------------------------------
      // CREATE
      //
      // Students can only create:
      //
      // - their own record
      // - for an enrolled course
      // - while the session is OPEN
      // - status = present
      // ----------------------------------------------------------

      allow create: if
        isStudent()

        && request.resource.data.studentId == request.auth.uid

        && request.resource.data.markedBy == request.auth.uid

        && request.resource.data.courseId is string

        && request.resource.data.sessionId is string

        && request.resource.data.status == "present"

        && isEnrolled(request.resource.data.courseId)

        && exists(
          /databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)
        )

        && get(
          /databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)
        ).data.courseId == request.resource.data.courseId

        && get(
          /databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)
        ).data.status == "open";


      // ----------------------------------------------------------
      // UPDATE
      //
      // Teacher/Admin can correct attendance.
      // Students cannot modify their attendance.
      // ----------------------------------------------------------

      allow update: if
        isAdmin()

        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)

          // Do not allow teacher to move the record
          // to another student/session/course.
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.sessionId == resource.data.sessionId
          && request.resource.data.courseId == resource.data.courseId
        );


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if isAdmin();
    }


    // ============================================================
    // PAYMENTS
    // ============================================================

    match /payments/{paymentId} {

      allow read: if
        isAdmin()
        || (
          isStudent()
          && resource.data.userId == request.auth.uid
        )
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        );

      allow create: if isAdmin();

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    // ============================================================
    // STUDENTS
    // ============================================================

    match /students/{studentId} {

      allow read: if
        isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == studentId
        )
        || isTeacher();

      allow create: if
        isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == studentId
        );

      allow update: if
        isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == studentId
        );

      allow delete: if isAdmin();
    }


    // ============================================================
    // INSTRUCTORS / TEACHERS
    // ============================================================

    match /instructors/{instructorId} {

      allow read: if isSignedIn();

      allow create: if isAdmin();

      allow update: if
        isAdmin()
        || (
          isTeacher()
          && request.auth.uid == instructorId
        );

      allow delete: if isAdmin();
    }


    // ============================================================
    // ANNOUNCEMENTS
    // ============================================================

    match /announcements/{announcementId} {

      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------

      allow read: if

        // ADMIN
        isAdmin()

        // --------------------------------------------------------
        // TEACHER - GLOBAL ANNOUNCEMENTS
        // --------------------------------------------------------
        ||
        (
          isTeacher()
          && resource.data.audienceType == "global"
          && resource.data.status == "published"
        )

        // --------------------------------------------------------
        // TEACHER - THEIR OWN COURSE ANNOUNCEMENTS
        // --------------------------------------------------------
        ||
        (
          isTeacher()
          && resource.data.audienceType == "course"
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )

        // --------------------------------------------------------
        // STUDENT - GLOBAL
        // --------------------------------------------------------
        ||
        (
          isStudent()
          && resource.data.audienceType == "global"
          && resource.data.status == "published"
        )

        // --------------------------------------------------------
        // STUDENT - ENROLLED COURSE
        // --------------------------------------------------------
        ||
        (
          isStudent()
          && resource.data.audienceType == "course"
          && resource.data.status == "published"
          && resource.data.courseId is string
          && isEnrolled(resource.data.courseId)
        );


      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------

      allow create: if

        // ADMIN CAN CREATE ANY TYPE
        isAdmin()

        // TEACHER CAN ONLY CREATE COURSE ANNOUNCEMENTS
        ||
        (
          isTeacher()
          && request.resource.data.audienceType == "course"
          && request.resource.data.courseId is string
          && isCourseOwner(request.resource.data.courseId)
          && request.resource.data.authorId == request.auth.uid
          && (
            request.resource.data.authorRole == "teacher"
            || request.resource.data.authorRole == "instructor"
          )
        );


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------

      allow update: if

        // ADMIN
        isAdmin()

        // TEACHER - OWN COURSE ANNOUNCEMENT
        ||
        (
          isTeacher()
          && resource.data.audienceType == "course"
          && resource.data.courseId is string
          && resource.data.authorId == request.auth.uid
          && isCourseOwner(resource.data.courseId)

          // Keep ownership fields unchanged
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.courseId == resource.data.courseId
          && request.resource.data.audienceType == resource.data.audienceType
        );


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if

        // ADMIN
        isAdmin()

        // TEACHER - OWN COURSE ANNOUNCEMENT
        ||
        (
          isTeacher()
          && resource.data.audienceType == "course"
          && resource.data.courseId is string
          && resource.data.authorId == request.auth.uid
          && isCourseOwner(resource.data.courseId)
        );
    }


    // ============================================================
    // DISCUSSIONS
    // ============================================================

    match /discussions/{discussionId} {

      allow read: if
        isAdmin()
        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )
        || (
          isStudent()
          && resource.data.courseId is string
          && isEnrolled(resource.data.courseId)
        );

      allow create: if
        isAdmin()

        || (
          isTeacher()
          && request.resource.data.courseId is string
          && isCourseOwner(request.resource.data.courseId)
          && request.resource.data.authorId == request.auth.uid
        )

        || (
          isStudent()
          && request.resource.data.courseId is string
          && isEnrolled(request.resource.data.courseId)
          && request.resource.data.authorId == request.auth.uid
        );

      allow update: if
        isAdmin()

        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )

        || (
          isStudent()
          && resource.data.authorId == request.auth.uid
        );

      allow delete: if
        isAdmin()

        || (
          isTeacher()
          && resource.data.courseId is string
          && isCourseOwner(resource.data.courseId)
        )

        || (
          isStudent()
          && resource.data.authorId == request.auth.uid
        );


      // ==========================================================
      // DISCUSSION REPLIES
      // ==========================================================

      match /replies/{replyId} {

        allow read: if
          isAdmin()

          || (
            isTeacher()
            && get(
              /databases/$(database)/documents/discussions/$(discussionId)
            ).data.courseId is string
            && isCourseOwner(
              get(
                /databases/$(database)/documents/discussions/$(discussionId)
              ).data.courseId
            )
          )

          || (
            isStudent()
            && get(
              /databases/$(database)/documents/discussions/$(discussionId)
            ).data.courseId is string
            && isEnrolled(
              get(
                /databases/$(database)/documents/discussions/$(discussionId)
              ).data.courseId
            )
          );


        allow create: if
          isAdmin()

          || (
            isTeacher()
            && get(
              /databases/$(database)/documents/discussions/$(discussionId)
            ).data.courseId is string
            && isCourseOwner(
              get(
                /databases/$(database)/documents/discussions/$(discussionId)
              ).data.courseId
            )
            && request.resource.data.authorId == request.auth.uid
          )

          || (
            isStudent()
            && get(
              /databases/$(database)/documents/discussions/$(discussionId)
            ).data.courseId is string
            && isEnrolled(
              get(
                /databases/$(database)/documents/discussions/$(discussionId)
              ).data.courseId
            )
            && request.resource.data.authorId == request.auth.uid
          );


        allow update: if
          isAdmin()
          || (
            isSignedIn()
            && resource.data.authorId == request.auth.uid
          );


        allow delete: if
          isAdmin()
          || (
            isSignedIn()
            && resource.data.authorId == request.auth.uid
          );
      }
    }


    // ============================================================
    // NOTIFICATIONS
    // ============================================================

    match /notifications/{notificationId} {

      allow read: if
        isAdmin()
        || (
          isSignedIn()
          && resource.data.recipientId == request.auth.uid
        );

      // Notifications should be created by admin/backend
      allow create: if isAdmin();

      allow update: if
        isAdmin()
        || (
          isSignedIn()
          && resource.data.recipientId == request.auth.uid
        );

      allow delete: if
        isAdmin()
        || (
          isSignedIn()
          && resource.data.recipientId == request.auth.uid
        );
    }


    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}